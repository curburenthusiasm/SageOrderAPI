# Copy to .env and fill in. The app reads these from the environment.

# --- Orderful API (leave blank to run in dry-run / simulated submission mode) ---
ORDERFUL_API_KEY=
ORDERFUL_BASE_URL=https://api.orderful.com/v2

# --- Our (vendor) X12 interchange identity ---
VENDOR_ISA_ID=JEFFCOFIBRES
VENDOR_ISA_QUALIFIER=ZZ

# --- Envelope ---
X12_VERSION=004010
EDI_USAGE_INDICATOR=P            # P = production, T = test

# --- Conversational LLM layer (Claude API) ---
# When set, /chat is driven by Claude with tool use. Without it, the agent
# falls back to the built-in deterministic command parser.
ANTHROPIC_API_KEY=
EDI_AGENT_MODEL=claude-opus-4-8
EDI_AGENT_LLM=1                  # set 0 to force the deterministic parser

# --- Phase 2 data sources ---
# SQL Server (product/inventory). Full pyodbc connection string, e.g.:
# DRIVER={ODBC Driver 17 for SQL Server};SERVER=JEF-SQL;DATABASE=MAS_JEF;UID=...;PWD=...
SQL_SERVER_CONN=
# Optional: override the product / inventory SQL (single ? param = item code)
# SQL_PRODUCT_QUERY=
# SQL_INVENTORY_QUERY=

# Shipping / tracking API
SHIPPING_API_KEY=
SHIPPING_API_BASE_URL=

# --- Optional: where to persist control-number state ---
# EDI_CONTROL_STATE=/var/lib/edi-agent/control_numbers.json
