# Copy to .env and fill in. The app reads these from the environment.

# --- Orderful API (leave blank to run in dry-run / simulated submission mode) ---
ORDERFUL_API_KEY=
ORDERFUL_BASE_URL=https://api.orderful.com/v2

# --- Our (vendor) X12 interchange identity ---
VENDOR_ISA_ID=JEFFCOFIBRES
VENDOR_ISA_QUALIFIER=ZZ

# --- Envelope ---
X12_VERSION=004010
EDI_USAGE_INDICATOR=P            # P = production, T = test

# --- Conversational LLM layer (Claude API) ---
# When set, /chat is driven by Claude with tool use. Without it, the agent
# falls back to the built-in deterministic command parser.
ANTHROPIC_API_KEY=
EDI_AGENT_MODEL=claude-opus-4-8
EDI_AGENT_LLM=1                  # set 0 to force the deterministic parser

# --- Phase 2: SQL Server (Sage 100 ERP) ---
# Full pyodbc connection string, e.g.:
# DRIVER={ODBC Driver 17 for SQL Server};SERVER=JEF-SQL;DATABASE=MAS_JEF;UID=...;PWD=...
SQL_SERVER_CONN=
# Optional: override the Sage 100 query stubs to match your exact columns.
# Each query takes a single ? parameter. See connectors/sql_reader.py.
# SQL_ORDER_HEADER_QUERY=
# SQL_ORDER_DETAIL_QUERY=
# SQL_INVOICE_HEADER_QUERY=
# SQL_INVOICE_DETAIL_QUERY=

# --- ROI InSynch API (write orders into Sage 100) ---
ROI_BASE_URL=https://roiconsultingapi.azurewebsites.net
ROI_COMPANY_CODE=JEF
ROI_API_SCOPE=api://17d2b604-8930-40bc-81ab-583fdca33c6f/.default
ROI_TOKEN_URL=https://login.microsoftonline.com/974b2ee7-8fca-4ab4-948a-02becfbf058f/oauth2/v2.0/token
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Sage defaults applied when an order/mapping doesn't carry them:
ROI_CUSTOMER_NO=
ROI_AR_DIVISION_NO=00
ROI_WAREHOUSE_CODE=000

# --- Phase 2: ShipStation (tracking / ASN data) ---
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=
SHIPSTATION_BASE_URL=https://ssapi.shipstation.com

# --- Phase 2: order state machine (SQLite) ---
STATE_DB_PATH=./edi_state.db

# --- Partner spec library / companion guides ---
SPECS_DIR=./edi_agent/specs
EDI_SPEC_GUIDED=1                # set 0 to skip the Claude spec-tailoring pass

# --- Optional: where to persist control-number state ---
# EDI_CONTROL_STATE=/var/lib/edi-agent/control_numbers.json
