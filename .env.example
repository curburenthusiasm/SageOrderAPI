# CEO Bot Configuration
# Copy this file to .env and fill in your actual values

# ===========================
# Email Configuration (Required for morning reports)
# ===========================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# ===========================
# Database Configuration (For SQL Bot)
# ===========================
DB_HOST=your_sql_server
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

DB_CONN_STR=DRIVER={ODBC Driver 17 for SQL Server};SERVER=your_server;DATABASE=your_db;UID=your_user;PWD=your_password;Encrypt=yes;TrustServerCertificate=yes;

# ===========================
# Tray.io Configuration (For Chrome Bot EDI)
# ===========================
TRAY_IO_URL=https://app.tray.io/workspaces/your_workspace_id
TRAY_IO_USERNAME=your_trayio_email
TRAY_IO_PASSWORD=your_trayio_password

# ===========================
# Teams Configuration (Optional - for webhooks)
# ===========================
TEAMS_WEBHOOK_URL=your_teams_webhook_url

# ===========================
# Anthropic Claude API (for InboxBot email responses + CW ticket triage)
# ===========================
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ===========================
# Ollama Configuration (for CEO Bot orchestration)
# ===========================
# Leave as default if Ollama is running locally
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
